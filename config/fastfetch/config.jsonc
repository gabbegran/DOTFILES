 {
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    // If working with tmux, you need to use kitty-icat instead of kitty-direct
    // https://discrd.com/channels/1005603569187160125/1324828708128821271/1327261766014599218
    "type": "small",
    // "type": "kitty-direct",
    // "type": "kitty-icat",
    // "source": "~/.config/fastfetch/images/star-saber-ship-linkarzu.png",
    "source": "arch_small",
    "color": {
     "1": "white",
     "2": "white" 
    },
    "height": 15,
    "width": 30,
    "position": "left",
    "padding": {
      "top": 0,
      "right": 5,
    },

  },   "modules": [
    "break",
    {
      "type": "host",
      "key": " ",
      "keyColor": "white",
      "format": "{2}"
    },
    {
      "type": "cpu",
      "key": " ",
      "keyColor": "white",
      "format": "{1}"
    },
    {
      "type": "gpu",
      "key": "󰒆 ",
      "keyColor": "white",
    },
    {
      "type": "memory",
      "key": " ",
      "keyColor": "white",
      "format": "{1} / {2}"
    },
    {
      "type": "disk",
      "key": " ",
      "folders": "/",
      "format": "{size-used} / {size-total}",
      "keyColor": "white",
    },
    {
      "type": "swap",
      "key": " ",
      "keyColor": "white",
      "format": "{1} / {2}"
      
    },
  ],
}
