[global]
    monitor = 0
    follow = mouse

    width = (0, 320)
    height = (0, 120)
    origin = bottom-center
    offset = (12, 12)
    scale = 0


    corner_radius = 16
    frame_width = 0
    icon_position = left
    min_icon_size = 32
    max_icon_size = 32
    padding = 10
    horizontal_padding = 12
    width = (0, 300)

    separator_color = frame
    sort = yes

    idle_threshold = 120
    font = JetBrainsMono Nerd Font 11
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = no

    icon_position = left
    min_icon_size = 24
    max_icon_size = 36

    sticky_history = yes
    history_length = 20

    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    corner_radius = 14
    ignore_dbusclose = false

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[experimental]
    per_monitor_dpi = false
[urgency_low]
    background = "#0a0a0e"
    foreground = "#8a8a8a"
    frame_color = "#1a1a1a"
    timeout = 4
    default_icon = dialog-information

[urgency_normal]
    background = "#0a0a0e"
    foreground = "#b2b2b2"
    frame_color = "#1a1a1a"
    timeout = 6
    default_icon = dialog-information

[urgency_critical]
    background = "#0f0808"
    foreground = "#c87870"
    frame_color = "#2a1212"
    timeout = 0
    default_icon = dialog-error
