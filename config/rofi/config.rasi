configuration {
    modi:                       "drun";
    show-icons:                 false;
    display-drun:               "";
    drun-display-format:        "{name}";
    font:                       "JetBrainsMono Nerd Font 12";
    terminal:                   "alacritty";
}

/* 1. GLOBAL RESET: This kills the hardcoded yellow/blue fallback colors */
* {
    background-color:            transparent;
    text-color:                  #eeeeee;
    margin:                      0px;
    padding:                     0px;
    spacing:                     0px;
}

window {
    width:                       500px;
    height:                      280px;
    location:                    center;
    anchor:                      center;
    
    /* BORDER FIX: Solid white border (Change #ffffff to #00ffff for Cyan) */
    border:                      0px solid;
    border-color:                #ffffff; 
    border-radius:               17px;
    
    background-color:            rgba(0, 0, 0, 0.8);
}

mainbox {
    enabled:                     true;
    children:                    [ "inputbar", "listview" ];
    background-color:            transparent;
}

/* 2. INPUT BAR */
inputbar {
    enabled:                     true;
    padding:                     25px 20px 10px 20px;
    background-color:            transparent;
    children:                    [ "prompt", "entry" ];
}

prompt {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  #ffffff;
    font:                        "JetBrains Mono Bold 13";
}

entry {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  #ffffff;
    cursor:                      text;
    placeholder:                 "Search...";
    placeholder-color:           #888888;
    margin:                      0px 0px 0px 10px;
}

/* 3. LISTVIEW: Strictly disables the scrollbar */
listview {
    enabled:                     true;
    columns:                     1;
    lines:                       4;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false; /* Hides the scrollbar widget */
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;
    
    spacing:                     5px;
    margin:                      10px 20px;
    background-color:            transparent;
}

/* 4. ELEMENTS: Fixes the selection highlight */
element {
    enabled:                     true;
    spacing:                     10px;
    padding:                     10px;
    border-radius:               8px;
    background-color:            transparent;
    text-color:                  #ffffff;
    cursor:                      pointer;
}

/* Important: Children must inherit to show the 'element selected' color */
element-text, element-icon {
    background-color:            transparent;
    text-color:                  inherit;
}

element-icon {
    size:                        28px;
    cursor:                      inherit;
}

/* This is the highlight bar that follows your selection */
element selected {
    background-color:            #44444444; /* White background (or use #00ffff) */
    text-color:                  #ffffff; /* Black text so it pops */
}
