;; ~/.config/eww/eww.yuck

(defwindow bar
  :monitor 0
  :geometry (geometry :x "0%"
                       :y "0%"
                       :width "100%"
                       :height "30px"
                       :anchor "top center")
  :stacking "fg"
  :reserve (struts :distance "40px" :side "top")
  :windowtype "dock"
  :wm-ignore false
  (bar-content))

(defwidget bar-content []
  (box :class "bar-window"
    (label :text "MONO_OS" :halign "start")
    (label :text {formattime(EWW_TIME, "%H:%M")} :halign "end")))
